# --- Environments & Secrets (CRITICAL SECURITY) ---
# Never commit actual secret keys or credentials
.env
.env*.local
*.pem
*.key

# --- Python ---
# Bytecode and cache generated by Python when running
__pycache__/
*.py[cod]
*$py.class
*.so

# Python Virtual Environments (packages installed locally)
.venv/
venv/
ENV/
env/

# Python test, coverage, and lint cache
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/
.mypy_cache/

# --- Node & Frontend ---
# Dependencies installed via npm
node_modules/
npm-debug.log*

# Production build outputs (these are generated by the build tool, not source code)
dist/
build/
out/

# Vite and framework caches
.vite/
.eslintcache

# --- Operating System & IDE Files ---
# Junk files created automatically by Windows / macOS
Thumbs.db
[Dd]esktop.ini
.DS_Store

# IDE workspace caches (keep personal settings out of team repo)
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
